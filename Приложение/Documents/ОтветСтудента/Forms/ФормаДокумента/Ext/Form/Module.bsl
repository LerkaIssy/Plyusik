// На клиенте
&НаКлиенте
Процедура СкачатьФайл(Команда)
    // Проверяем, существует ли документ
    Если Объект.Ссылка.Пустая() Тогда
        ПоказатьПредупреждение(, "Документ не записан! Сохраните документ перед скачиванием файла.");
        Возврат;
    КонецЕсли;
    
    // Получаем список файлов из регистра сведений
    СписокФайлов = ПолучитьСписокФайловНаСервере(Объект.Ссылка);
    Если СписокФайлов.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Файлы для данного документа не найдены!");
        Возврат;
    КонецЕсли;
    
    // Выбираем файл для скачивания
    ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораФайлаДляСкачивания", ЭтотОбъект);
    ПоказатьВыборИзСписка(ОписаниеОповещения, СписокФайлов, , Ложь);
КонецПроцедуры

// Обработчик выбора файла для скачивания
&НаКлиенте
Процедура ПослеВыбораФайлаДляСкачивания(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
    Если ВыбранныйЭлемент = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ИмяФайла = ВыбранныйЭлемент.Значение;
    АдресФайла = ПолучитьДанныеФайлаНаСервере(Объект.Ссылка, ИмяФайла);
    Если Не ПустаяСтрока(АдресФайла) Тогда
        СохранитьФайлНаДиск(АдресФайла, ИмяФайла);
    Иначе
        ПоказатьПредупреждение(, "Не удалось получить данные файла!");
    КонецЕсли;
КонецПроцедуры

// Процедура сохранения файла на диск
&НаКлиенте
Процедура СохранитьФайлНаДиск(АдресФайла, ИмяФайла)
    Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
    Диалог.Заголовок = "Сохранить файл как";
    Диалог.ПолноеИмяФайла = ИмяФайла;
    
    ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПутиСохранения", ЭтотОбъект, АдресФайла);
    Диалог.Показать(ОписаниеОповещения);
КонецПроцедуры

// Обработчик выбора пути сохранения
&НаКлиенте
Процедура ПослеВыбораПутиСохранения(ВыбранныеФайлы, АдресФайла) Экспорт
    Если ВыбранныеФайлы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ПутьСохранения = ВыбранныеФайлы[0];
    ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
    Если ДвоичныеДанные <> Неопределено Тогда
        ДвоичныеДанные.Записать(ПутьСохранения);
        ПоказатьОповещениеПользователя("Успех", , "Файл сохранен по пути: " + ПутьСохранения);
    Иначе
        ПоказатьПредупреждение(, "Ошибка при сохранении файла!");
    КонецЕсли;
КонецПроцедуры       





// На сервере
&НаСервере
Функция ПолучитьСписокФайловНаСервере(СсылкаНаДокумент)
    СписокФайлов = Новый СписокЗначений;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ОтветыСтудентов.ИмяФайла
        |ИЗ
        |    РегистрСведений.ОтветыСтудентов КАК ОтветыСтудентов
        |ГДЕ
        |    ОтветыСтудентов.ОтветСтудента = &СсылкаНаДокумент";
    
    Запрос.УстановитьПараметр("СсылкаНаДокумент", СсылкаНаДокумент);
    Результат = Запрос.Выполнить();
    
    Если Не Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Пока Выборка.Следующий() Цикл
            СписокФайлов.Добавить(Выборка.ИмяФайла, Выборка.ИмяФайла);
        КонецЦикла;
    КонецЕсли;
    
    Возврат СписокФайлов;
КонецФункции


// На сервере
&НаСервере
Функция ПолучитьДанныеФайлаНаСервере(СсылкаНаДокумент, ИмяФайла)
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ОтветыСтудентов.ДанныеФайла
        |ИЗ
        |    РегистрСведений.ОтветыСтудентов КАК ОтветыСтудентов
        |ГДЕ
        |    ОтветыСтудентов.ОтветСтудента = &СсылкаНаДокумент
        |    И ОтветыСтудентов.ИмяФайла = &ИмяФайла";
    
    Запрос.УстановитьПараметр("СсылкаНаДокумент", СсылкаНаДокумент);
    Запрос.УстановитьПараметр("ИмяФайла", ИмяФайла);
    Результат = Запрос.Выполнить();
    
    Если Не Результат.Пустой() Тогда
        Выборка = Результат.Выбрать();
        Выборка.Следующий();
        ДвоичныеДанные = Выборка.ДанныеФайла.Получить();
        Если ДвоичныеДанные <> Неопределено Тогда
            Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
        Иначе
            Сообщить("Ошибка: Двоичные данные файла пустые!");
        КонецЕсли;
    Иначе
        Сообщить("Ошибка: Файл с именем " + ИмяФайла + " не найден!");
    КонецЕсли;
    
    Возврат "";
КонецФункции
